{
  "manifest_version": 3,
  "name": "FakeTL",
  "version": "1.2.1",
  "description": "FakeTimeLanguage: choose website time zones and languages, with site exceptions and an English/Russian interface.",
  "minimum_chrome_version": "145",
  "permissions": ["storage", "userScripts", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_popup": "popup.html", "default_title": "FakeTL · FakeTimeLanguage", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["main.js"],
    "world": "MAIN",
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true,
    "match_origin_as_fallback": true
  }]
}
