{
  "manifest_version": 3,
  "name": "FakeTL",
  "version": "1.2.0",
  "description": "FakeTimeLanguage: choose website time zones and languages, with site exceptions and an English/Russian interface.",
  "minimum_chrome_version": "145",
  "permissions": ["storage", "userScripts", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "FakeTL · FakeTimeLanguage"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["main.js"],
    "world": "MAIN",
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true,
    "match_origin_as_fallback": true
  }]
}
